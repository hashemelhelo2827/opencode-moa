{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["npx", "@playwright/mcp@latest"]
    }
  },
  "provider": {
    "opencode": {
      "models": {
        "deepseek-v4-flash-free": {
          "limit": { "context": 200000, "input": 200000, "output": 128000 }
        },
        "big-pickle": {
          "limit": { "context": 200000, "input": 200000, "output": 32000 }
        }
      }
    },
    "mistral": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://api.mistral.ai/v1",
        "apiKey": "{env:MISTRAL_API_KEY}"
      },
      "models": {
        "mistral-medium-2604": {
          "limit": { "context": 262144, "output": 262144 }
        },
        "mistral-small-2603": {
          "limit": { "context": 256000, "output": 256000 }
        }
      }
    }
  },
  "agent": {
    "moa-mistral-reviewer": {
      "model": "mistral/mistral-small-2603",
      "description": "moa-v2 reviewer (lo tier) — semantic coverage (Gate A), evidence normalization (E1), structure passes (Gate B-light)",
      "mode": "subagent"
    },
    "moa-mistral-reviewer-hi": {
      "model": "mistral/mistral-medium-2604",
      "description": "moa-v2 reviewer (high tier) — Gate B module/security passes, Gate D threat cases for sensitive tasks",
      "mode": "subagent"
    },
    "moa-gemini35": {
      "model": "google/gemini-3.5-flash",
      "description": "Frontend, UI/UX, and design plan authoring for the MoA team (quota-limited; writes plan only)",
      "mode": "subagent"
    },
    "moa-gemini3": {
      "model": "google/gemini-3-flash",
      "description": "Fallback for Gemini 3.5 Flash — frontend, UI/UX, and design plan authoring (quota-limited; writes plan only)",
      "mode": "subagent"
    },
    "moa-deepseek": {
      "model": "opencode/deepseek-v4-flash-free",
      "description": "General reasoning, synthesis, implementation, and code fixes for the MoA team",
      "mode": "subagent"
    },
    "moa-nemotron": {
      "model": "opencode/nemotron-3-ultra-free",
      "description": "Analysis, edge cases, and optimization for the MoA team",
      "mode": "subagent"
    },
    "moa-north": {
      "model": "opencode/mimo-v2.5-free",
      "description": "Code review, programming analysis, and quality assurance for the MoA team",
      "mode": "subagent"
    },
    "moa-mimo": {
      "model": "opencode/mimo-v2.5-free",
      "description": "Programming and implementation for the MoA team",
      "mode": "subagent"
    },
    "moa-bigpickle": {
      "model": "opencode/big-pickle",
      "description": "Creative direction and brainstorming for the MoA team",
      "mode": "subagent"
    },
    "moa-runtime-verifier": {
      "description": "moa-v2 runtime verifier — script-only Docker sandbox executor for Gate C",
      "mode": "subagent"
    }
  }
}
